-- // UPGRADE TAB — AUTO UPGRADE ALL
-- ============================================================
Tabs.Upgrade:AddParagraph({
    Title   = "Auto Upgrade",
    Content = "Upgrades All.",
})

local autoUpgrade = false

local function runAutoUpgrade()
    while autoUpgrade do
        for floor = 1, 3 do
            for slot = 1, 10 do
                if not autoUpgrade then break end
                pcall(function()
                    Events:WaitForChild("RequestSlotUpgrade"):FireServer(
                        "Floor" .. floor,
                        "Slot"  .. slot
                    )
                end)
                task.wait(0.07)
            end
            if not autoUpgrade then break end
        end
        task.wait(0.5)
    end
end

