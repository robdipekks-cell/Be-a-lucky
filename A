-- // Helper: get plot
local function getPlot()
    return workspace:WaitForChild("Plot_" .. LocalPlayer.Name, 5)
        or workspace:WaitForChild("Plot_whity_plays", 5)
end

-- // Helper: TP (sets CFrame over multiple frames so physics can't snap back)
local function tpTo(cf, yOffset)
    yOffset = yOffset or 5
    local char = LocalPlayer.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local target = CFrame.new(cf.Position + Vector3.new(0, yOffset, 0))
    for i = 1, 5 do
        hrp.CFrame = target
        hrp.AssemblyLinearVelocity  = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        task.wait()
    end
end

