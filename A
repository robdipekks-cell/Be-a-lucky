})

-- ============================================================
-- // COLLECT TAB — AUTO COLLECT
-- ============================================================
Tabs.Collect:AddParagraph({
    Title   = "Auto Collect",
    Content = "Collect everything",
})

local autoCollect = false

local function runAutoCollect()
    while autoCollect do
        local plot = getPlot()
        if not plot then task.wait(2) continue end

        for floor = 1, 3 do
            if not autoCollect then break end
            local floorObj    = plot:FindFirstChild("Floor" .. floor)
            if not floorObj then continue end
            local slotsFolder = floorObj:FindFirstChild("Slots")
            if not slotsFolder then continue end

            for slot = 1, 10 do
                if not autoCollect then break end
                local slotObj      = slotsFolder:FindFirstChild("Slot" .. slot)
                if not slotObj then continue end
                local collectTouch = slotObj:FindFirstChild("CollectTouch")
                if not collectTouch then continue end

                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    firetouchinterest(hrp, collectTouch, 0)
                    task.wait(0.05)
                    firetouchinterest(hrp, collectTouch, 1)
                end
                task.wait(0.1)
            end
        end

        task.wait(1)
    end
end

