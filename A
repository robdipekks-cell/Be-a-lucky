-- ============================================================
-- // MAIN TAB — AUTO FARM
-- ============================================================
Tabs.Main:AddParagraph({
    Title   = "Auto Farm",
    Content = "Farms Last Base.",
})

local autoFarm = false

local function runAutoFarm()
    while autoFarm do
        local bases  = workspace:FindFirstChild("Bases")
        local base11 = bases and bases:FindFirstChild("Base11")

        if not base11 then
            Fluent:Notify({ Title = "Auto Farm", Content = "Base11 not found!", Duration = 3 })
            task.wait(2)
            continue
        end

tpTo(base11:GetPivot())
        task.wait(0.5)
        tpTo(base11:GetPivot())

        task.wait(5.5)

        -- Fire NotifyHatched before TPing back
        pcall(function()
            Events:WaitForChild("NotifyHatched"):FireServer(1)
        end)

        local plot = workspace:WaitForChild("Plot_" .. LocalPlayer.Name, 5)
                  or workspace:WaitForChild("Plot_whitey_plays", 5)
        if plot then
            tpTo(plot:GetPivot(), 10)
        end

        task.wait(1)
    end
end

Tabs.Main:AddToggle("ToggleAutoFarm", {
    Title       = "Auto Farm",
    Description = "Farm last base.",
    Default     = false,
    Callback    = function(val)
        autoFarm = val
        if val then
            task.spawn(runAutoFarm)
            Fluent:Notify({ Title = "Auto Farm", Content = "Started!", Duration = 3 })
        else
            Fluent:Notify({ Title = "Auto Farm", Content = "Stopped.", Duration = 3 })
        end
    end,
})

